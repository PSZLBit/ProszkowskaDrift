# Normalize text files to LF in the repository; keep Windows checkouts usable.
* text=auto eol=lf

# Shell scripts and hooks
*.sh text eol=lf
.githooks/* text eol=lf

# Documentation
*.md text eol=lf

# Go
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Kotlin / Java / Gradle / Android resources
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.pro text eol=lf

# GDScript / Godot text resources
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf

# Data formats
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.sql text eol=lf

# Binary assets: never diff or convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.apk binary
*.aab binary
*.jar binary
*.zip binary
*.gz binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.keystore binary
*.jks binary
*.p12 binary
